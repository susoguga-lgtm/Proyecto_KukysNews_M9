{{#if user}}
    <div class="card shadow p-5 text-center mt-5">
        <h1 class="texto-bienvenida mb-3">¡Bienvenida de vuelta, {{user.nombre}}! 📰</h1>
        <p class="lead">Estás en tu panel de control. Desde aquí puedes publicar las últimas noticias.</p>
        
        <div class="mt-4">
            <a href="/noticias/crear" class="btn btn-success px-5 rounded-pill shadow-sm">Publicar una Noticia</a>
        </div>
    </div>
{{else}}
    <div class="card shadow p-5 text-center mt-5">
        <h1 class="text-dark mb-3">Kuky's News 📰</h1>
        <p class="lead">Tú portal de noticias. Inicia sesión o regístrate para ser parte de nuestra comunidad.</p>
        
        <div class="mt-4">
            <a href="/auth/login" class="btn btn-outline-primary me-2 px-4">Ingresar</a>
            <a href="/auth/register" class="btn btn-primary px-4">Registrarse</a>
        </div>

        <div class="mt-4 pt-3 border-top">
            <button onclick="alert('Para publicar una noticia debe iniciar sesión. Si no tiene una cuenta, debe registrarse.')" class="btn btn-success px-5 rounded-pill shadow-sm">
                Publicar una Noticia
            </button>
        </div>
    </div>
{{/if}}

{{#if mensajeExito}}
    <div class="alert alert-success mt-4 text-center fw-bold shadow-sm">
        ¡Excelente! La noticia ha sido publicada con éxito. 📰✅
    </div>
{{/if}}

{{#if mensajeEditado}}
    <div class="alert alert-warning mt-4 text-center fw-bold shadow-sm">
        Noticia actualizada correctamente. ✏️
    </div>
{{/if}}

{{#if mensajeEliminado}}
    <div class="alert alert-danger mt-4 text-center fw-bold shadow-sm">
        La noticia ha sido eliminada. 🗑️
    </div>
{{/if}}
<div class="container mt-5">
    <h3 class="mb-4 border-bottom pb-2">Últimas Noticias</h3>
    
    <div class="row">
        {{#each noticias}}
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <span class="badge bg-primary mb-3">{{this.categoria}}</span>
                        <h4 class="card-title fw-bold text-dark">{{this.titulo}}</h4>
                        <p class="card-text text-muted text-truncate">{{this.contenido}}</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted text-truncate" style="max-width: 150px;">{{this.createdAt}}</small>
                        <a href="/noticias/{{this.id}}" class="btn btn-sm btn-primary">Leer más</a>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="col-12 text-center my-5">
                <h5 class="text-muted">Aún no hay noticias publicadas. ¡Sé el primero en escribir una!</h5>
            </div>
        {{/each}}
    </div>
</div>