<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card p-4 shadow">
            <h2 class="text-center mb-4">✏️ Editar Noticia</h2>
            <form action="/noticias/editar/{{noticia.id}}" method="POST">
                <div class="mb-3">
                    <label class="form-label fw-bold">Título</label>
                    <input type="text" name="titulo" class="form-control" value="{{noticia.titulo}}" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Categoría</label>
                    <select name="categoria" class="form-select" required>
                        <option value="{{noticia.categoria}}" selected>{{noticia.categoria}} (Actual)</option>
                        <option value="Nacional">Nacional</option>
                        <option value="Internacional">Internacional</option>
                        <option value="Deportes">Deportes</option>
                        <option value="Clima">Clima</option>
                        <option value="Tecnología">Tecnología</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Contenido</label>
                    <textarea name="contenido" class="form-control" rows="6" required>{{noticia.contenido}}</textarea>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="/noticias/{{noticia.id}}" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-warning">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>